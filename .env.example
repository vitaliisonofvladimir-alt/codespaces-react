# Copy this file to .env.local and replace the placeholder.
# Never use a VITE_ prefix for this key because Vite exposes it to the browser.
OPENAI_API_KEY=sk-your-openai-api-key
# Optional only after the browser origin is configured to forward the request
# with the correct tenant Host; leave blank to use the same-origin /v1 proxy.
VITE_LEADS_API_BASE_URL=
