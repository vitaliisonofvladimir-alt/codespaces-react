# Copy this file to .env.local and replace the placeholder.
# Never use a VITE_ prefix for this key because Vite exposes it to the browser.
OPENAI_API_KEY=sk-your-openai-api-key
# Optional while the tenant-aware gateway is being designed. Leave blank to use
# the same-origin /v1 path; do not point this at a shared backend origin unless
# that edge route preserves the tenant Host and credential policy.
VITE_AUTH_API_BASE_URL=
VITE_LEADS_API_BASE_URL=
