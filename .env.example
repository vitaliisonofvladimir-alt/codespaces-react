# Copy this file to .env.local and replace the placeholder.
# Never use a VITE_ prefix for this key because Vite exposes it to the browser.
OPENAI_API_KEY=sk-your-openai-api-key
# Optional API origins. Leave blank for same-origin/local Vite proxy routing.
# Staging ignores these values and defaults to the fixed staging API origin;
# no Access token or other credential may be placed in a VITE_* variable.
VITE_AUTH_API_BASE_URL=
VITE_LEADS_API_BASE_URL=
